---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import WorkCard from "@/components/WorkCard.astro";
import { portfolio } from "@/data/site";
import { breadcrumbSchema } from "@/lib/schema";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Our Work", href: "/work/" },
];
---

<BaseLayout
  title="Our Work — Websites, Apps & Brands We've Built"
  description="See websites, apps and brands built by Myers Group Media for Mississippi businesses and organizations, including Harrell Garage Doors, Mississippi News Group and RCTV19."
  schema={[breadcrumbSchema(crumbs)]}
  contact={{ heading: "Want something like this for your business?" }}
>
  <PageHero
    crumbs={crumbs}
    title="Work we are proud of"
    lead="Local service companies, news and media networks, community organizations and more. Every project below is live — click through and see for yourself."
  />

  <section class="section">
    <div class="wrap grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {portfolio.map((item, i) => <WorkCard item={item} eager={i < 3} />)}
    </div>
  </section>
</BaseLayout>
