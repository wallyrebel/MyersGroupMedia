---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Icon from "@/components/Icon.astro";
import { site } from "@/data/site";
import { services } from "@/data/services";
import { breadcrumbSchema } from "@/lib/schema";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about/" },
];
const years = new Date().getFullYear() - site.founded;
const values = [
  { icon: "users", title: "One team, one call", text: "Most companies handle one slice. We handle web, hosting, apps, IT, marketing, design and software together, so the pieces actually connect." },
  { icon: "bolt", title: "We do the work", text: "We do not hand over a slide deck and disappear. We build it, run it and keep improving it." },
  { icon: "handshake", title: "Honest advice", text: "If you do not need an app, a rebuild or a bigger ad budget, we will say so. We would rather earn your trust than your invoice." },
  { icon: "pin", title: "Local roots", text: "Our office is in Ripley, Mississippi, and we work with the businesses, schools and organizations that make these towns what they are." },
];
---

<BaseLayout
  title="About Us — North Mississippi Web, IT & Marketing"
  description={`Founded by ${site.founder} in ${site.founded}, ${site.name} has spent ${years} years helping Mississippi businesses grow with websites, technology and marketing.`}
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    title={`Helping Mississippi businesses grow online since ${site.founded}`}
    lead={`${site.name} was founded by ${site.founder} in ${site.founded}. ${years} years later we are still doing what we set out to do: making technology and marketing simple for local businesses.`}
  />

  <section class="section">
    <div class="wrap grid lg:grid-cols-12 gap-10 lg:gap-14">
      <div class="lg:col-span-7 prose">
        <h2>Our story</h2>
        <p>
          We started in {site.founded}, when search engine optimization was a niche skill, social media was a novelty and most local businesses still did not have a website. We learned the craft while the rules were being written, and we have kept up with every change since.
        </p>
        <p>
          Along the way we have built brands and audiences to a combined <strong>one million social media followers</strong> and more than <strong>100 million views every month</strong>, and launched more than <strong>200 brands</strong>. Those are not vanity numbers. They are audiences that call, click, buy and show up.
        </p>
        <p>
          Today we work with local service businesses, news and media networks, restaurants and gathering places, manufacturers and community organizations across North Mississippi. What connects them is simple: they want one dependable team to handle the technical side so they can get on with running the business.
        </p>
        <h2>What we do</h2>
        <p>
          We offer {services.length} services, and they are designed to work together:
        </p>
        <ul>
          {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a> — {s.short.charAt(0).toLowerCase() + s.short.slice(1)}</li>)}
        </ul>
      </div>

      <aside class="lg:col-span-5 space-y-5 self-start">
        <dl class="card p-7 grid grid-cols-2 gap-6">
          {site.stats.map((s) => (
            <div class="flex flex-col-reverse">
              <dt class="text-[0.9rem] text-muted mt-1">{s.label}</dt>
              <dd class="font-display font-extrabold text-ink text-3xl tracking-tight">{s.value}</dd>
            </div>
          ))}
        </dl>
        <div class="card p-7">
          <h2 class="h3">Founder</h2>
          <p class="mt-2"><strong class="text-ink">{site.founder}</strong> founded {site.name} in {site.founded} and still leads the work today.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section bg-surface" aria-labelledby="values-heading">
    <div class="wrap">
      <div class="max-w-3xl mb-10">
        <p class="eyebrow mb-3">How we work</p>
        <h2 id="values-heading" class="h2">What you can expect from us</h2>
      </div>
      <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {values.map((v) => (
          <li class="card p-6">
            <span class="icon-tile mb-4"><Icon name={v.icon} size={24} /></span>
            <h3 class="h3">{v.title}</h3>
            <p class="mt-2 text-[0.98rem]">{v.text}</p>
          </li>
        ))}
      </ul>
      <a href="/process/" class="link inline-block mt-8">See how a project works, step by step</a>
    </div>
  </section>
</BaseLayout>
