---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Icon from "@/components/Icon.astro";
import { services } from "@/data/services";
import { locations } from "@/data/locations";
import { breadcrumbSchema } from "@/lib/schema";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Services", href: "/services/" },
];
---

<BaseLayout
  title="Services — Web Design, Hosting, IT & Marketing"
  description="Web design, web hosting, app development, IT services, marketing and SEO, social media marketing, graphic design and custom software for North Mississippi businesses."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    title="Services for North Mississippi businesses"
    lead="Eight services, one local team. Use us for a single project or let us handle all of it — your website, your technology and your marketing working together."
  />

  <section class="section">
    <div class="wrap grid md:grid-cols-2 gap-6">
      {services.map((s) => (
        <article class="card p-7 flex flex-col">
          <div class="flex items-start gap-4">
            <span class="icon-tile"><Icon name={s.icon} size={24} /></span>
            <div>
              <h2 class="h3 !text-[1.4rem]"><a href={`/services/${s.slug}/`} class="hover:text-brand transition-colors">{s.name}</a></h2>
              <p class="mt-1.5">{s.short}</p>
            </div>
          </div>
          <ul class="mt-5 grid sm:grid-cols-2 gap-x-4 gap-y-2 text-[0.96rem]">
            {s.includes.map((inc) => (
              <li class="flex items-start gap-2"><Icon name="check" size={18} class="text-brand mt-1 shrink-0" />{inc.title}</li>
            ))}
          </ul>
          <a href={`/services/${s.slug}/`} class="btn btn-outline btn-sm mt-6 self-start">
            {s.name} details <Icon name="arrow" size={17} />
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="section bg-surface" aria-labelledby="areas-heading">
    <div class="wrap">
      <h2 id="areas-heading" class="h2 max-w-2xl">Available across North Mississippi</h2>
      <p class="mt-4 max-w-2xl">Every service is available in each of the areas we serve. Choose yours for local details.</p>
      <ul class="mt-7 flex flex-wrap gap-2.5">
        {locations.map((l) => (
          <li><a href={`/areas/${l.slug}/`} class="chip"><Icon name="pin" size={16} class="text-brand" />{l.full}</a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
