---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Icon from "@/components/Icon.astro";
import QuickEmail from "@/components/QuickEmail.astro";
import { site, mailto } from "@/data/site";
import { locations } from "@/data/locations";
import { breadcrumbSchema } from "@/lib/schema";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Contact", href: "/contact/" },
];
const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `Contact ${site.name}`,
  url: `${site.url}/contact/`,
};
---

<BaseLayout
  title="Contact Us — Call (662) 576-1554 or Email"
  description="Contact Myers Group Media. Call (662) 576-1554 or click to email us about web design, hosting, apps, IT, marketing, social media, graphic design or custom software in North Mississippi."
  schema={[contactSchema, breadcrumbSchema(crumbs)]}
  contact={false}
>
  <PageHero
    crumbs={crumbs}
    title="Two easy ways to reach us"
    lead="Call, or click to email — your email opens with our address already filled in. A real person answers, usually within one business day."
    buttons={false}
  />

  <section class="section">
    <div class="wrap">
      <!-- The two big options -->
      <div class="grid md:grid-cols-2 gap-5">
        <a href={site.phoneHref} class="card p-7 sm:p-9 flex items-center gap-5 group !border-brand-200 bg-brand-50" data-cta="call">
          <span class="grid place-items-center w-16 h-16 rounded-2xl bg-brand text-white shrink-0"><Icon name="call" size={30} /></span>
          <span>
            <span class="block text-[0.95rem] font-semibold text-brand-dark">Tap to call</span>
            <span class="block font-display font-extrabold text-ink text-[1.65rem] sm:text-3xl tracking-tight group-hover:text-brand transition-colors">{site.phone}</span>
            <span class="block text-[0.92rem] text-muted mt-0.5">{site.hours}</span>
          </span>
        </a>
        <a href={mailto()} class="card p-7 sm:p-9 flex items-center gap-5 group" data-cta="email">
          <span class="grid place-items-center w-16 h-16 rounded-2xl bg-navy-900 text-white shrink-0"><Icon name="mail" size={30} /></span>
          <span class="min-w-0">
            <span class="block text-[0.95rem] font-semibold text-brand-dark">Click to email</span>
            <span class="block font-display font-extrabold text-ink text-[1.15rem] sm:text-[1.4rem] tracking-tight group-hover:text-brand transition-colors break-all">{site.email}</span>
            <span class="block text-[0.92rem] text-muted mt-0.5">Opens your email, ready to send</span>
          </span>
        </a>
      </div>

      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 mt-12">
        <div class="lg:col-span-7">
          <QuickEmail heading="Or write your question here" />
        </div>

        <aside class="lg:col-span-5 space-y-5">
          <div class="card p-7">
            <h2 class="h3">What happens next</h2>
            <ol class="mt-4 space-y-3 text-[0.98rem]">
              {[
                "You call or send your email.",
                "A real person replies, usually within one business day.",
                "We talk through what you need and send a clear written quote.",
              ].map((t, i) => (
                <li class="flex gap-3">
                  <span class="grid place-items-center w-7 h-7 rounded-full bg-brand text-white font-display font-bold text-[0.85rem] shrink-0">{i + 1}</span>
                  {t}
                </li>
              ))}
            </ol>
          </div>
          <div class="card p-7">
            <h2 class="h3">Hours</h2>
            <p class="mt-2 flex items-center gap-2.5"><Icon name="clock" size={19} class="text-brand" />{site.hours}</p>
            <h2 class="h3 mt-6">Where we work</h2>
            <p class="mt-2 text-[0.98rem]">All of North Mississippi, including:</p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {locations.filter((l) => l.kind !== "region").map((l) => (
                <li><a href={`/areas/${l.slug}/`} class="tag hover:bg-brand-100 transition-colors">{l.name}</a></li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
