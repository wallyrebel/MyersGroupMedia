---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Icon from "@/components/Icon.astro";
import { processSteps } from "@/data/site";
import { breadcrumbSchema } from "@/lib/schema";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "How We Work", href: "/process/" },
];
const details = [
  ["A phone call or an email is all it takes", "No forms to fill out, no sales pitch", "We listen first"],
  ["Written scope, timeline and price", "No surprise charges", "You decide if and when to start"],
  ["Regular progress updates", "You review real work, not mockups of mockups", "Changes are part of the process"],
  ["We handle the technical launch", "Training if you want to make your own updates", "Ongoing support from the same team"],
];
const promises = [
  { icon: "clock", title: "We reply quickly", text: "Calls and emails are answered by a real person, usually within one business day." },
  { icon: "handshake", title: "No surprises", text: "You approve the price and the plan before we start." },
  { icon: "users", title: "Same team, start to finish", text: "The people you talk to at the start are the people doing the work." },
];
---

<BaseLayout
  title="How We Work — Our Simple 4-Step Process"
  description="How a project with Myers Group Media works: talk it through, get a clear written plan and price, review as we build, then launch with ongoing support."
  schema={[breadcrumbSchema(crumbs)]}
  contact={{ heading: "Step one is easy. Call or email." }}
>
  <PageHero
    crumbs={crumbs}
    title="How we work: simple, clear and no surprises"
    lead="Whether it is a website, an app, an office network or a marketing plan, every project follows the same four steps."
  />

  <section class="section">
    <div class="wrap max-w-4xl">
      <ol class="space-y-6">
        {processSteps.map((step, i) => (
          <li class="card p-6 sm:p-8 flex flex-col sm:flex-row gap-5">
            <span class="grid place-items-center w-12 h-12 rounded-full bg-brand text-white font-display font-bold text-lg shrink-0">{i + 1}</span>
            <div>
              <h2 class="h3 !text-[1.45rem]">{step.title}</h2>
              <p class="mt-2">{step.text}</p>
              <ul class="mt-4 space-y-2 text-[0.98rem]">
                {details[i].map((d) => (
                  <li class="flex items-start gap-2.5"><Icon name="check" size={18} class="text-brand mt-1 shrink-0" />{d}</li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bg-surface" aria-labelledby="promise-heading">
    <div class="wrap">
      <h2 id="promise-heading" class="h2 mb-8">What you can count on</h2>
      <ul class="grid md:grid-cols-3 gap-5">
        {promises.map((p) => (
          <li class="card p-6">
            <span class="icon-tile mb-4"><Icon name={p.icon} size={24} /></span>
            <h3 class="h3">{p.title}</h3>
            <p class="mt-2 text-[0.98rem]">{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
