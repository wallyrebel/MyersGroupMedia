---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Icon from "@/components/Icon.astro";
import { breadcrumbSchema } from "@/lib/schema";
import { postImage } from "@/lib/blog";

const posts = (await getCollection("journal", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmtDate = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Blog", href: "/journal/" },
];
---

<BaseLayout
  title="Blog — Web, Marketing & Tech Advice"
  description="Straight talk on websites, SEO, social media, apps, software and advertising from Myers Group Media — written for business owners, not tech people."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    title="The Myers Group Media blog"
    lead="Straight talk on websites, marketing and technology — written for business owners, not tech people."
    buttons={false}
  />

  <section class="section">
    <div class="wrap grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((p) => (
        <a href={`/journal/${p.id}/`} class="card overflow-hidden flex flex-col group">
          {postImage(p.data.image) && (
            <img src={postImage(p.data.image)} alt="" loading="lazy" decoding="async" width="640" height="360" class="w-full aspect-[16/9] object-cover" />
          )}
          <div class="p-6 flex flex-col gap-3 flex-1">
            <p class="text-[0.85rem] text-muted">
              <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>{p.data.category && <> · {p.data.category}</>}
            </p>
            <h2 class="h3 group-hover:text-brand transition-colors">{p.data.title}</h2>
            <p class="text-[0.96rem] line-clamp-4">{p.data.excerpt}</p>
            <span class="mt-auto pt-2 inline-flex items-center gap-1.5 font-semibold text-brand text-[0.95rem]">
              Read article <Icon name="arrow" size={17} class="transition-transform group-hover:translate-x-1" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
