---
/** Accessible FAQ accordion (native <details>, no JavaScript needed). */
import type { Faq } from "@/data/services";

interface Props {
  faqs: Faq[];
  heading?: string;
  intro?: string;
}
const { faqs, heading = "Common questions", intro } = Astro.props;
---

<section class="section bg-white" aria-labelledby="faq-heading">
  <div class="wrap grid lg:grid-cols-12 gap-8 lg:gap-14">
    <div class="lg:col-span-4">
      <p class="eyebrow mb-3">FAQ</p>
      <h2 id="faq-heading" class="h2">{heading}</h2>
      {intro && <p class="mt-4">{intro}</p>}
    </div>
    <div class="lg:col-span-8 faq border-t border-line">
      {faqs.map((f) => (
        <details>
          <summary><h3 class="font-[inherit] text-[length:inherit] tracking-normal">{f.q}</h3></summary>
          <p class="faq-a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
