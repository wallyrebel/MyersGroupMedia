---
import Icon from "@/components/Icon.astro";
import Logo from "@/components/Logo.astro";
import { site, mailto } from "@/data/site";
import { services } from "@/data/services";
import { locations } from "@/data/locations";

const year = new Date().getFullYear();
const company = [
  { href: "/work/", label: "Our Work" },
  { href: "/about/", label: "About" },
  { href: "/process/", label: "How We Work" },
  { href: "/journal/", label: "Blog" },
  { href: "/contact/", label: "Contact" },
  { href: "/privacy/", label: "Privacy" },
];
const social = [
  { href: site.social.facebook, label: "Facebook" },
  { href: site.social.instagram, label: "Instagram" },
  { href: site.social.linkedin, label: "LinkedIn" },
  { href: site.social.googleBusiness, label: "Google" },
].filter((s) => s.href);
const addr = site.address;
const footLink = "inline-block py-1.5 text-[#c5cee3] hover:text-white transition-colors";
---

<footer class="bg-navy-950 on-dark border-t border-white/10">
  <div class="wrap pt-14 pb-10">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href="/" aria-label={`${site.name} — home`}><Logo tone="light" /></a>
        <p class="mt-5 max-w-sm text-[0.98rem]">
          Web design, hosting, apps, IT, marketing, social media, graphic design and custom software for {site.region} businesses. In business since {site.founded}.
        </p>
        <ul class="mt-6 space-y-1">
          <li>
            <a href={site.phoneHref} class="inline-flex items-center gap-2.5 py-1.5 font-display font-bold text-white text-lg hover:text-brand-light transition-colors" data-cta="call">
              <Icon name="call" size={19} class="text-brand-light" />
              {site.phone}
            </a>
          </li>
          <li>
            <a href={mailto()} class="inline-flex items-center gap-2.5 py-1.5 font-semibold text-white hover:text-brand-light transition-colors break-all" data-cta="email">
              <Icon name="mail" size={19} class="text-brand-light shrink-0" />
              {site.email}
            </a>
          </li>
          <li class="flex items-center gap-2.5 py-1.5">
            <Icon name="clock" size={19} class="text-brand-light" />
            {site.hours}
          </li>
          {addr.city && (
            <li class="flex items-start gap-2.5 py-1.5">
              <Icon name="pin" size={19} class="text-brand-light mt-1" />
              <span>{addr.street && <>{addr.street}<br /></>}{addr.city}, {addr.state} {addr.zip}</span>
            </li>
          )}
        </ul>
        {social.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-x-5">
            {social.map((s) => (
              <li><a href={s.href} class={footLink} rel="noopener" target="_blank">{s.label}</a></li>
            ))}
          </ul>
        )}
      </div>

      <nav class="lg:col-span-3" aria-label="Services">
        <h2 class="font-display font-bold text-white text-base tracking-normal mb-3">Services</h2>
        <ul>
          {services.map((s) => (
            <li><a href={`/services/${s.slug}/`} class={footLink}>{s.name}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="lg:col-span-3" aria-label="Areas we serve">
        <h2 class="font-display font-bold text-white text-base tracking-normal mb-3">Areas We Serve</h2>
        <ul class="grid grid-cols-2 lg:grid-cols-1 xl:grid-cols-2 gap-x-4">
          {locations.map((l) => (
            <li><a href={`/areas/${l.slug}/`} class={footLink}>{l.name}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="lg:col-span-2" aria-label="Company">
        <h2 class="font-display font-bold text-white text-base tracking-normal mb-3">Company</h2>
        <ul>
          {company.map((c) => (
            <li><a href={c.href} class={footLink}>{c.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col md:flex-row gap-2 md:items-center md:justify-between text-[0.9rem] text-[#96a2bd]">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Proudly serving Corinth, Ripley, New Albany, Booneville, Tupelo, Oxford and all of North Mississippi.</p>
    </div>
  </div>
</footer>
